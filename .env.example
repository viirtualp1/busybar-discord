# ── The Bar ───────────────────────────────────────────────────────────────
# Wi-Fi: the device's address, and the HTTP Access password from its settings.
BUSY_ADDR=http://192.168.0.186
BUSY_HTTP_PASSWORD=

# Behind busybar-wm, point this at the daemon instead and leave the rest empty.
# BUSY_ADDR=http://127.0.0.1:4111

# Higher wins the screen when two apps draw at once.
DRAW_PRIORITY=40

# ── Discord ───────────────────────────────────────────────────────────────
# Make an application at https://discord.com/developers/applications and copy
# these from its OAuth2 page. It does not need a bot, and it never joins your
# server — this talks to the Discord app already running on this machine.
#
# RPC scopes are only granted to the account that OWNS the application, so the
# account you sign in to the developer portal with has to be the one sitting in
# the call.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Must be one of the redirects registered on that OAuth2 page.
DISCORD_REDIRECT_URI=http://localhost

# Drop rpc.voice.write if you do not want the mute button and Discord is
# fussing about the scope.
# DISCORD_SCOPES=rpc,rpc.voice.read,rpc.voice.write

# ── The display ───────────────────────────────────────────────────────────
# How many faces at once. More than five and they stop being faces; the rest
# are counted at the end of the strip instead.
MAX_AVATARS=5

# Music bots and the like are in the channel but not in the conversation.
HIDE_BOTS=1

# Photographs are dark at twelve pixels. 1 leaves them exactly as they came.
AVATAR_GAIN=1.15

# ── The buttons ───────────────────────────────────────────────────────────
# Which of the Bar's buttons toggles your microphone: start, ok, back, none.
#
# START is the default because busybar-wm does not use it — it takes OK to
# cycle apps and BACK to hand the choice back. Note that busybar-nowplaying
# also binds START, to play/pause: if you run both, one press does both things.
MUTE_BUTTON=start

# Turn the Bar's controls off entirely.
BAR_INPUT=1

